DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supertalks?schema=public
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret

# ---------------------------------------------------------------------------
# PhonePe Payment Gateway (Standard Checkout v2, OAuth based).
# Leave the three PHONEPE_CLIENT_* vars empty to keep using the mock provider
# (POST /payments/:id/complete with no gateway).
#   sandbox | production
PHONEPE_ENV=sandbox

# API keys issued by PhonePe (Business Dashboard -> Developer Settings).
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_CLIENT_SECRET=

# Public base URL of THIS backend, reachable from the internet, used to build
# the redirect URL PhonePe bounces the user back to (https in production).
PHONEPE_BASE_URL=http://localhost:3000

# Optional webhook verification (configure a webhook in the PhonePe dashboard).
# Use ONE of the two methods:
#   HMAC webhook:            PHONEPE_WEBHOOK_SECRET=<checksum secret key>
#   SHA (username/password): PHONEPE_WEBHOOK_USERNAME / PHONEPE_WEBHOOK_PASSWORD
# PHONEPE_WEBHOOK_SECRET=
# PHONEPE_WEBHOOK_USERNAME=
# PHONEPE_WEBHOOK_PASSWORD=

# Optional overrides.
# PHONEPE_API_BASE_URL=            e.g. explicit sandbox/production gateway host
# PHONEPE_AUTH_API_BASE_URL=       e.g. explicit oauth token host
# PHONEPE_RETURN_FALLBACK_URL=     frontend URL if a user returns without saving one
# PHONEPE_RETURN_ALLOWED_ORIGINS=  extra comma-separated origins allowed as return targets

# ---------------------------------------------------------------------------
# Cloudinary (signed direct uploads via POST /cloudinary/signature)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=grahaura/infinity/v1